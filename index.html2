var curType=-1;

function goPage(id){
  document.querySelectorAll('.page').forEach(function(p){p.classList.remove('active');});
  document.getElementById(id).classList.add('active');
}
function toast(msg){
  var el=document.getElementById('toast');
  el.textContent=msg;el.classList.add('show');
  setTimeout(function(){el.classList.remove('show');},2400);
}
function fill(str,num){return str.replace(/{NUM}/g,num||'[NUMÉRO]');}

// Access
document.getElementById('btn-access').addEventListener('click',function(){
  var v=document.getElementById('inp-access').value.trim().toUpperCase();
  if(v===ACCESS.toUpperCase()){
    document.getElementById('err-access').style.display='none';
    document.getElementById('inp-access').value='';
    goPage('page-main');
  } else {
    document.getElementById('err-access').style.display='block';
    var inp=document.getElementById('inp-access');
    inp.style.borderColor='#ff4466';
    setTimeout(function(){inp.style.borderColor='';},900);
  }
});
document.getElementById('inp-access').addEventListener('keydown',function(e){if(e.key==='Enter')document.getElementById('btn-access').click();});

// Type select
for(var i=0;i<4;i++){
  (function(idx){
    document.getElementById('t'+idx).addEventListener('click',function(){
      curType=idx;
      for(var j=0;j<4;j++) document.getElementById('t'+j).classList.remove('sel');
      document.getElementById('t'+idx).classList.add('sel');
      var num=document.getElementById('inp-phone').value.trim();
      document.getElementById('tpl-box').textContent=fill(tpls[idx].body,num);
    });
  })(i);
}
document.getElementById('inp-phone').addEventListener('input',function(){
  if(curType<0)return;
  document.getElementById('tpl-box').textContent=fill(tpls[curType].body,this.value.trim());
});

// SEND — multi-méthodes pour forcer Gmail Android
document.getElementById('btn-send').addEventListener('click',function(){
  if(curType<0){toast('⚠️ CHOISIR UN TYPE');return;}
  var num=document.getElementById('inp-phone').value.trim();
  var t=tpls[curType];
  var sub=encodeURIComponent(fill(t.subj,num));
  var bod=encodeURIComponent(fill(t.body,num));
  var mailtoUrl='mailto:'+TO+'?subject='+sub+'&body='+bod;

  // MÉTHODE 1 — Intent Android natif Gmail
  try{
    var intent='intent://send?to='+encodeURIComponent(TO)
      +'&subject='+sub+'&body='+bod
      +'#Intent;scheme=mailto;package=com.google.android.gm;end';
    var a1=document.createElement('a');
    a1.href=intent;a1.style.display='none';
    document.body.appendChild(a1);a1.click();
    setTimeout(function(){if(document.body.contains(a1))document.body.removeChild(a1);},300);
  }catch(e){}

  // MÉTHODE 2 — mailto via lien <a> avec dispatchEvent
  setTimeout(function(){
    try{
      var a2=document.createElement('a');
      a2.href=mailtoUrl;a2.style.display='none';
      document.body.appendChild(a2);
      var ev=new MouseEvent('click',{bubbles:true,cancelable:true,view:window});
      a2.dispatchEvent(ev);
      setTimeout(function(){if(document.body.contains(a2))document.body.removeChild(a2);},300);
    }catch(e){}
  },200);

  // MÉTHODE 3 — window.location fallback
  setTimeout(function(){
    window.location.href=mailtoUrl;
  },500);

  toast('📨 OUVERTURE GMAIL...');
});

// Nav
document.getElementById('nav-home').addEventListener('click',function(){goPage('page-access');});
document.getElementById('nav-opts').addEventListener('click',function(){
  document.getElementById('inp-editcode').value='';
  document.getElementById('err-edit').style.display='none';
  goPage('page-editcode');
});

// Edit code
document.getElementById('btn-editcode').addEventListener('click',function(){
  var v=document.getElementById('inp-editcode').value.trim().toUpperCase();
  if(v===EDITPW.toUpperCase()){
    document.getElementById('err-edit').style.display='none';
    buildForms();goPage('page-edit');
  } else {
    document.getElementById('err-edit').style.display='block';
  }
});
document.getElementById('inp-editcode').addEventListener('keydown',function(e){if(e.key==='Enter')document.getElementById('btn-editcode').click();});
document.getElementById('btn-back1').addEventListener('click',function(){goPage('page-main');});

// Edit templates
var labels=['BAN V1 — Compte Banni','BAN V2 — Compte Piraté','BAN V3 — Bug App','BAN V4 — Numéro Bloqué'];
function buildForms(){
  var c=document.getElementById('edit-forms');c.innerHTML='';
  tpls.forEach(function(t,i){
    var d=document.createElement('div');
    d.style.cssText='margin-bottom:14px;position:relative;z-index:1;';
    d.innerHTML='<label class="lbl" style="display:block;margin-bottom:6px;">'+labels[i]+'</label><textarea class="edit-area" id="ef'+i+'">'+t.body+'</textarea>';
    c.appendChild(d);
  });
}
document.getElementById('btn-save').addEventListener('click',function(){
  tpls.forEach(function(t,i){var el=document.getElementById('ef'+i);if(el)t.body=el.value;});
  toast('💾 SAUVEGARDÉ !');
  setTimeout(function(){goPage('page-main');},1100);
});
document.getElementById('btn-back2').addEventListener('click',function(){goPage('page-main');});

})();
</script>
</body>
</html>
